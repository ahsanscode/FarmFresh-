<%- include("partials/header.ejs") %>  <!-- Include header from partials -->



    <!-- Page Header -->
    <section class="page-header">
        <div class="container">
            <h1 class="page-title">All Marketplace Products</h1>
            <p class="page-subtitle">Browse our complete collection of farm-fresh produce at honest prices</p>
            <nav class="breadcrumb">
                <a href="/" class="breadcrumb-link">Home</a>
                <span class="breadcrumb-separator">/</span>
                <span class="breadcrumb-current">All Products</span>
            </nav>
        </div>
    </section>

    <!-- All Products Section -->
    <section id="all-products" class="marketplace">
        <div class="container products-container">
            <!-- Filter Sidebar -->
            <aside class="filter-sidebar">
                <div class="filter-header">
                    <h3>Filters</h3>
                    <button class="clear-filters-btn" onclick="clearAllFilters()">Clear All</button>
                </div>

                <!-- Category Filter -->
                <div class="filter-section">
                    <h4 class="filter-title">Categories</h4>
                    <div class="filter-options">
                        <label class="filter-checkbox">
                            <input type="checkbox" class="category-filter" value="all" checked>
                            <span>All Categories</span>
                        </label>
                        <label class="filter-checkbox">
                            <input type="checkbox" class="category-filter" value="vegetables">
                            <span>Vegetables</span>
                        </label>
                        <label class="filter-checkbox">
                            <input type="checkbox" class="category-filter" value="fruits">
                            <span>Fruits</span>
                        </label>
                        <label class="filter-checkbox">
                            <input type="checkbox" class="category-filter" value="dairy">
                            <span>Dairy Products</span>
                        </label>
                        <label class="filter-checkbox">
                            <input type="checkbox" class="category-filter" value="grains">
                            <span>Grains & Cereals</span>
                        </label>
                    </div>
                </div>

                <!-- Price Range Filter -->
                <div class="filter-section">
                    <h4 class="filter-title">Price Range</h4>
                    <div class="price-range-container">
                        <div class="price-inputs">
                            <input type="number" class="price-input" id="minPrice" placeholder="Min" min="0">
                            <span class="price-separator">-</span>
                            <input type="number" class="price-input" id="maxPrice" placeholder="Max" min="0">
                        </div>
                        <button class="btn-apply-price" onclick="applyPriceFilter()">Apply</button>
                    </div>
                </div>

                <!-- Rating Filter -->
                <div class="filter-section">
                    <h4 class="filter-title">Rating</h4>
                    <div class="filter-options">
                        <label class="filter-checkbox">
                            <input type="checkbox" class="rating-filter" value="5">
                            <span>★★★★★ 5 Stars</span>
                        </label>
                        <label class="filter-checkbox">
                            <input type="checkbox" class="rating-filter" value="4">
                            <span>★★★★☆ 4+ Stars</span>
                        </label>
                        <label class="filter-checkbox">
                            <input type="checkbox" class="rating-filter" value="3">
                            <span>★★★☆☆ 3+ Stars</span>
                        </label>
                        <label class="filter-checkbox">
                            <input type="checkbox" class="rating-filter" value="2">
                            <span>★★☆☆☆ 2+ Stars</span>
                        </label>
                    </div>
                </div>

                <!-- Stock Status Filter -->
                <div class="filter-section">
                    <h4 class="filter-title">Availability</h4>
                    <div class="filter-options">
                        <label class="filter-checkbox">
                            <input type="checkbox" class="stock-filter" value="in-stock" checked>
                            <span>In Stock</span>
                        </label>
                        <label class="filter-checkbox">
                            <input type="checkbox" class="stock-filter" value="low-stock">
                            <span>Low Stock</span>
                        </label>
                        <label class="filter-checkbox">
                            <input type="checkbox" class="stock-filter" value="out-of-stock">
                            <span>Out of Stock</span>
                        </label>
                    </div>
                </div>

                <!-- Verified Seller Filter -->
                <div class="filter-section">
                    <h4 class="filter-title">Seller Status</h4>
                    <div class="filter-options">
                        <label class="filter-checkbox">
                            <input type="checkbox" class="verified-filter" value="verified">
                            <span>Verified Sellers Only</span>
                        </label>
                    </div>
                </div>

                <!-- Sort Options -->
                <div class="filter-section">
                    <h4 class="filter-title">Sort By</h4>
                    <select class="sort-select" id="sortSelect" onchange="applySorting()">
                        <option value="newest">Newest Arrivals</option>
                        <option value="price-low">Price: Low to High</option>
                        <option value="price-high">Price: High to Low</option>
                        <option value="rating">Highest Rated</option>
                        <option value="best-selling">Best Selling</option>
                    </select>
                </div>
            </aside>

            <!-- Products Section -->
            <div class="products-main">
                <div class="section-header">
                    <div>
                        <h2 class="section-title">Fresh Marketplace</h2>
                        <p class="section-subtitle">Farm-fresh produce at honest prices</p>
                    </div>
                    <div class="filter-tabs">
                        <button class="filter-btn active">All</button>
                        <button class="filter-btn">Vegetables</button>
                        <button class="filter-btn">Fruits</button>
                        <button class="filter-btn">Dairy</button>
                        <button class="filter-btn">Grains</button>
                    </div>
                </div>
                <div class="product-grid">
                <% if (products && products.length > 0) { %>
                    <% products.forEach(product => { %>
                        <% 
                            const price = Number(product.price) || 0;
                            const marketPrice = Number(product.market_price) || null;
                            const savings = marketPrice && price
                                ? Math.round((1 - price / marketPrice) * 100)
                                : 0;
                            const stockQty = Number(product.stock_quantity) || 0;
                            const firstLetter = (product.name || 'P').toString().charAt(0).toUpperCase();
                            const category = (product.category || 'Other').toString();
                        %>
                        <div class="product-card" data-category="<%= category %>">
                            <a href="/product/<%= product.id %>">
                                <div class="product-image">
                                     <img src="<%= product.image_url ? product.image_url : '/uploads/default-product.png' %>" 
                                         alt="<%= product.name %>" 
                                         onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%27300%27 height=%27200%27%3E%3Crect fill=%27%23e8f5e9%27 width=%27300%27 height=%27200%27/%3E%3Ctext fill=%27%232ecc71%27 font-family=%27Arial%27 font-size=%2716%27 x=%2750%25%27 y=%2750%25%27 dominant-baseline=%27middle%27 text-anchor=%27middle%27%3E<%= firstLetter %>%3C/text%3E%3C/svg%3E'">
                                    <div class="product-badges">
                                        <% if (product.is_verified) { %>
                                            <span class="badge badge-verified"><i class="fas fa-snowflake"></i> Verified</span>
                                        <% } %>
                                        <span class="badge badge-fresh"><i class="fas fa-leaf"></i> Fresh Arrival</span>
                                    </div>
                                    <button class="wishlist-btn"><i class="far fa-heart"></i></button>
                                </div>
                            </a>
                            <div class="product-info">
                                <h3 class="product-name"><a href="/product/<%= product.id %>"><%= product.name %></a></h3>
                                <p class="product-origin">Grown by <a href="/farmer/<%= product.farmer_id %>" class="farmer-link"><%= product.farm_name || 'Local Farm' %></a></p>
                                <div class="product-pricing">
                                    <span class="farm-price">৳<%= price %>/<%= product.unit || 'kg' %></span>
                                    <% if (marketPrice) { %>
                                        <span class="market-price">৳<%= marketPrice %>/<%= product.unit || 'kg' %></span>
                                        <span class="savings">Save <%= savings %>%</span>
                                    <% } %>
                                </div>
                                <p style="font-size: 0.9rem; color: #666; margin: 5px 0;">Stock: <%= stockQty %> available</p>
                                <div style="display: flex; align-items: center; gap: 10px; margin: 10px 0;">
                                    <span style="font-size: 0.9rem; color: #666;">Quantity:</span>
                                    <div style="display: flex; align-items: center; border: 1px solid #ddd; border-radius: 6px; overflow: hidden;">
                                        <button type="button" onclick="decrementQty(<%= product.id %>)" style="background: #f5f5f5; border: none; padding: 8px 12px; cursor: pointer; font-size: 16px; color: #666;">
                                            <i class="fas fa-minus"></i>
                                        </button>
                                        <input type="number" id="qty-<%= product.id %>" value="1" min="1" max="<%= stockQty %>" 
                                               onchange="validateQty(<%= product.id %>, <%= stockQty %>)"
                                               style="width: 50px; border: none; text-align: center; padding: 8px 4px; font-size: 14px;">
                                        <button type="button" onclick="incrementQty(<%= product.id %>, <%= stockQty %>)" style="background: #f5f5f5; border: none; padding: 8px 12px; cursor: pointer; font-size: 16px; color: #666;">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                </div>
                                <button class="btn btn-primary btn-block" onclick="addToCartFromGrid(<%= product.id %>)">Add to Cart</button>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div style="grid-column: 1/-1; text-align: center; padding: 40px;">
                        <p style="font-size: 1.2rem; color: #666;">No products available yet.</p>
                        <p>Check back soon for fresh farm products!</p>
                    </div>
                <% } %>
            </div>
            </div>
        </div>
    </section>

<script>
    // Store all products data for filtering
    let allProducts = [];
    let filteredProducts = [];

    // Initialize products array from DOM
    function initializeProducts() {
        allProducts = Array.from(document.querySelectorAll('.product-card')).map(card => ({
            element: card,
            category: (card.getAttribute('data-category') || '').toLowerCase(),
            price: parseFloat(card.querySelector('.farm-price')?.textContent.match(/\d+/)?.[0] || 0),
            stock: parseInt(card.querySelector('p:contains("Stock:")') || 0),
            rating: parseFloat(card.querySelector('.rating-stars')?.getAttribute('data-rating') || 0),
            verified: card.querySelector('.badge-verified') !== null
        }));
        filteredProducts = [...allProducts];
    }

    // Apply all active filters
    function applyAllFilters() {
        initializeProducts();
        filteredProducts = allProducts.filter(product => {
            // Category filter
            const categoryCheckboxes = document.querySelectorAll('.category-filter:checked');
            const allCatChecked = Array.from(categoryCheckboxes).some(cb => cb.value === 'all');
            const selectedCategories = Array.from(categoryCheckboxes)
                .filter(cb => cb.value !== 'all')
                .map(cb => cb.value.toLowerCase());
            
            if (!allCatChecked && selectedCategories.length > 0) {
                if (!selectedCategories.includes(product.category)) return false;
            }

            // Price range filter
            const minPrice = parseFloat(document.getElementById('minPrice')?.value || 0);
            const maxPrice = parseFloat(document.getElementById('maxPrice')?.value || Infinity);
            if (product.price < minPrice || product.price > maxPrice) return false;

            // Rating filter
            const ratingCheckboxes = document.querySelectorAll('.rating-filter:checked');
            if (ratingCheckboxes.length > 0) {
                const minRating = Math.min(...Array.from(ratingCheckboxes).map(cb => parseInt(cb.value)));
                if (product.rating < minRating) return false;
            }

            // Stock filter
            const stockCheckboxes = document.querySelectorAll('.stock-filter:checked');
            if (stockCheckboxes.length > 0) {
                const selectedStocks = Array.from(stockCheckboxes).map(cb => cb.value);
                let matches = false;
                
                for (const stock of selectedStocks) {
                    if (stock === 'in-stock' && product.stock > 10) matches = true;
                    if (stock === 'low-stock' && product.stock > 0 && product.stock <= 10) matches = true;
                    if (stock === 'out-of-stock' && product.stock === 0) matches = true;
                }
                if (!matches) return false;
            }

            // Verified filter
            if (document.querySelector('.verified-filter:checked')) {
                if (!product.verified) return false;
            }

            return true;
        });

        applySorting();
        updateProductDisplay();
    }

    // Apply sorting
    function applySorting() {
        const sortValue = document.getElementById('sortSelect')?.value || 'newest';

        switch(sortValue) {
            case 'price-low':
                filteredProducts.sort((a, b) => a.price - b.price);
                break;
            case 'price-high':
                filteredProducts.sort((a, b) => b.price - a.price);
                break;
            case 'rating':
                filteredProducts.sort((a, b) => b.rating - a.rating);
                break;
            case 'best-selling':
                // Can be enhanced with sales data
                filteredProducts.sort(() => Math.random() - 0.5);
                break;
            case 'newest':
            default:
                // Keep original order
                break;
        }
        updateProductDisplay();
    }

    // Update product display based on filtered results
    function updateProductDisplay() {
        const cards = document.querySelectorAll('.product-card');
        cards.forEach(card => {
            const isVisible = filteredProducts.some(p => p.element === card);
            card.style.display = isVisible ? '' : 'none';
        });

        // Show "no results" message if needed
        const grid = document.querySelector('.product-grid');
        const visibleCount = Array.from(cards).filter(c => c.style.display !== 'none').length;
        
        let noResultsMsg = document.querySelector('.no-results-message');
        if (visibleCount === 0) {
            if (!noResultsMsg) {
                noResultsMsg = document.createElement('div');
                noResultsMsg.className = 'no-results-message';
                noResultsMsg.style.cssText = 'grid-column: 1/-1; text-align: center; padding: 40px; color: #666; font-size: 1.1rem;';
                noResultsMsg.textContent = 'No products match your filters. Try adjusting your criteria.';
                grid.appendChild(noResultsMsg);
            }
        } else if (noResultsMsg) {
            noResultsMsg.remove();
        }
    }

    // Apply price filter
    function applyPriceFilter() {
        applyAllFilters();
    }

    // Clear all filters
    function clearAllFilters() {
        document.querySelectorAll('.category-filter, .rating-filter, .stock-filter, .verified-filter').forEach(input => {
            input.checked = (input.classList.contains('category-filter') || input.classList.contains('stock-filter')) && input.value === 'all' ? true : input.classList.contains('stock-filter') && input.value === 'in-stock' ? true : false;
        });
        document.getElementById('minPrice').value = '';
        document.getElementById('maxPrice').value = '';
        document.getElementById('sortSelect').value = 'newest';
        applyAllFilters();
    }

    // Event listeners for filters
    document.addEventListener('DOMContentLoaded', function() {
        initializeProducts();

        // Category filters
        document.querySelectorAll('.category-filter').forEach(checkbox => {
            checkbox.addEventListener('change', applyAllFilters);
        });

        // Rating filters
        document.querySelectorAll('.rating-filter').forEach(checkbox => {
            checkbox.addEventListener('change', applyAllFilters);
        });

        // Stock filters
        document.querySelectorAll('.stock-filter').forEach(checkbox => {
            checkbox.addEventListener('change', applyAllFilters);
        });

        // Verified filter
        document.querySelectorAll('.verified-filter').forEach(checkbox => {
            checkbox.addEventListener('change', applyAllFilters);
        });

        // Price inputs (real-time filtering)
        document.getElementById('minPrice')?.addEventListener('input', applyAllFilters);
        document.getElementById('maxPrice')?.addEventListener('input', applyAllFilters);
    });

    // Mobile navigation toggle
    const navToggle = document.querySelector('.nav-toggle');
    const navMenu = document.querySelector('.nav-menu');
    const navActions = document.querySelector('.nav-actions');
    
    if (navToggle && navMenu && navActions) {
        navToggle.addEventListener('click', function() {
            navMenu.classList.toggle('active');
            navActions.classList.toggle('active');
        });
    }

    // Category filter functionality (works for all users)
    (function() {
        const tabs = document.querySelectorAll('.filter-btn');
        const cards = document.querySelectorAll('.product-card');
        function normalize(str){ return (str || '').toString().trim().toLowerCase(); }
        function setActive(tab){
            tabs.forEach(t => t.classList.toggle('active', t === tab));
        }
        function applyTabFilter(cat){
            const target = normalize(cat);
            cards.forEach(card => {
                const c = normalize(card.getAttribute('data-category'));
                const show = target === 'all' || c === target;
                card.style.display = show ? '' : 'none';
            });
        }
        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                const label = tab.textContent || 'All';
                setActive(tab);
                applyTabFilter(label);
            });
        });
        // Initialize to currently active tab
        const initial = Array.from(tabs).find(t => t.classList.contains('active')) || tabs[0];
        if (initial) {
            applyTabFilter(initial.textContent || 'All');
        }
    })();

    // Smooth scroll for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if (target) {
                target.scrollIntoView({
                    behavior: 'smooth'
                });
            }
        });
    });

    // Add to Cart from grid
    async function addToCartFromGrid(productId) {
        try {
            const qtyInput = document.getElementById(`qty-${productId}`);
            const quantity = qtyInput ? parseInt(qtyInput.value) : 1;
            
            const response = await fetch('/cart/add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    productId: productId,
                    quantity: quantity
                })
            });
            
            const data = await response.json();
            
            if (data.success) {
                // Product added to cart successfully; update cart badge only if new item
                if (data.isNewItem) {
                    updateCartBadge(1);
                }
                // Reset quantity to 1 after adding
                if (qtyInput) qtyInput.value = 1;
            } else {
                if (response.status === 401) {
                    window.location.href = '/login';
                } else {
                    alert(data.message || 'Failed to add to cart');
                }
            }
        } catch (err) {
            console.error('Error adding to cart:', err);
            alert('Error adding to cart');
        }
    }

    // Increment quantity
    function incrementQty(productId, maxStock) {
        const input = document.getElementById(`qty-${productId}`);
        if (input) {
            const current = parseInt(input.value) || 1;
            if (current < maxStock) {
                input.value = current + 1;
            }
        }
    }

    // Decrement quantity
    function decrementQty(productId) {
        const input = document.getElementById(`qty-${productId}`);
        if (input) {
            const current = parseInt(input.value) || 1;
            if (current > 1) {
                input.value = current - 1;
            }
        }
    }

    // Validate quantity input
    function validateQty(productId, maxStock) {
        const input = document.getElementById(`qty-${productId}`);
        if (input) {
            let value = parseInt(input.value) || 1;
            if (value < 1) {
                input.value = 1;
            } else if (value > maxStock) {
                input.value = maxStock;
                alert(`Maximum available stock is ${maxStock}`);
            } else {
                input.value = value;
            }
        }
    }

    // Increment cart badge without reload
    function updateCartBadge(increment = 1) {
        const cartBtn = document.querySelector('.btn.btn-icon[aria-label="Cart"]');
        if (!cartBtn) return;

        let badge = cartBtn.querySelector('.cart-count');
        if (!badge) {
            badge = document.createElement('span');
            badge.className = 'cart-count';
            badge.textContent = String(increment);
            cartBtn.appendChild(badge);
            return;
        }

        const current = parseInt(badge.textContent || '0', 10);
        const next = isNaN(current) ? increment : current + increment;
        badge.textContent = String(next);
    }

</script>

<%- include("partials/footer.ejs") %>  <!-- Include footer from partials -->